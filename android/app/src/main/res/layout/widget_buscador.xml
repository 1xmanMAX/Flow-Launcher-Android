<?xml version="1.0" encoding="utf-8"?>
<!-- El widget del buscador: la barra; tocarla abre el buscador con el teclado ya puesto. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/w_barra"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/widget_fondo"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/buscar"
            android:src="@drawable/ic_google" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_pista"
            android:textColor="@color/widget_texto"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/w_voz"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/widget_voz"
            android:padding="8dp"
            android:src="@drawable/w_mic" />
    </LinearLayout>

</FrameLayout>
